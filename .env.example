# Plantilla de credenciales GoHighLevel.
# Copia este archivo a .env y coloca tus valores reales.
#   cp .env.example .env
#
# El .env real NUNCA se sube a git (ver .gitignore).

# Private Integration Token: GHL -> Settings -> Private Integrations
# Crea el token con SOLO los scopes que necesites (mínimo privilegio).
GHL_PIT=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Location ID del sub-account (lo ves en la URL o en Settings -> Business Info)
GHL_LOCATION_ID=your_location_id_here
